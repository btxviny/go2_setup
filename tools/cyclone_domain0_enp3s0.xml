<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Used by launch_all_sensors_docker.sh, passed as CYCLONEDDS_URI to the
  domain_bridge process ONLY (not to rviz2, not to the ros2 CLI, not to the
  container -- see cyclone_domain42_lo.xml for those, which is fine as-is).

  domain_bridge is the only process in this setup that opens two different
  ROS_DOMAIN_IDs (0 and 42) within the SAME process. A single unscoped
  <Domain> block (no id attribute) applies to EVERY domain a process opens --
  so a version of this file with just one generic <Domain><General>
  <NetworkInterfaceAddress>enp3s0</NetworkInterfaceAddress> block (as this
  file used to be) forced domain_bridge's domain-42 participant to ALSO try
  binding enp3s0 instead of loopback ("lo"), same as its domain-0 side. Since
  rviz2 (and everything else on domain 42) binds "lo" via
  cyclone_domain42_lo.xml, domain_bridge's wrongly-enp3s0-bound domain-42
  side could never discover them -- SPDP/basic discovery partially worked
  (ports bound, participants existed) but no publisher/topic ever appeared
  on domain 42, silently. Confirmed via extensive live debugging (see
  previous_approaches_and_build_history.md) -- a minimal single-topic bridge
  reproduced it, a fresh process reproduced it, basic domain-42 pub/sub with
  plain ros2 CLI tools worked fine (ruling out a general domain-42/loopback
  problem), and explicitly scoping each domain below fixed it immediately.

  Each <Domain id="N"> block below applies ONLY to a participant opened with
  that exact ROS_DOMAIN_ID -- domain 0 gets enp3s0 (the dock-facing side),
  domain 42 gets lo (matching cyclone_domain42_lo.xml, PC-local only).
-->
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain id="0">
    <General>
      <Interfaces>
        <NetworkInterface name="enp3s0" />
      </Interfaces>
    </General>
  </Domain>
  <Domain id="42">
    <General>
      <Interfaces>
        <NetworkInterface name="lo" />
      </Interfaces>
    </General>
  </Domain>
</CycloneDDS>
