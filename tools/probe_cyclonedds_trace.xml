<?xml version="1.0" encoding="UTF-8"?>
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain id="any">
    <General>
      <Interfaces>
        <NetworkInterface name="enp7s0" priority="default" multicast="default"/>
      </Interfaces>
      <AllowMulticast>true</AllowMulticast>
      <MaxMessageSize>65500B</MaxMessageSize>
    </General>
    <Discovery>
      <ParticipantIndex>auto</ParticipantIndex>
    </Discovery>
    <Tracing>
      <Category>config,discovery</Category>
      <OutputFile>/tmp/opencode/dds_probe/cdds.log</OutputFile>
    </Tracing>
  </Domain>
</CycloneDDS>
